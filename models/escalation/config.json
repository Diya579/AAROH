    "sleep_disturbance",
    "sleep_disturbance_missing",
    "fear_intensity",
    "fear_intensity_missing",
    "help_requested",
    "help_requested_missing",
    "checkin_consistency",
    "checkin_consistency_missing",
    "engagement_drop",
